{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "dev": {
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "dev",
        "EXPO_PUBLIC_API_URL": "https://dev.api.rowie.eu",
        "EXPO_PUBLIC_WS_URL": "wss://dev.api.rowie.eu",
        "EXPO_PUBLIC_WEBSITE_URL": "https://dev.rowie.eu",
        "EXPO_PUBLIC_VENDOR_DASHBOARD_URL": "https://dev.portal.rowie.eu",
        "EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY": ""
      }
    },
    "prod": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "prod",
        "EXPO_PUBLIC_API_URL": "https://api.rowie.eu",
        "EXPO_PUBLIC_WS_URL": "wss://api.rowie.eu",
        "EXPO_PUBLIC_WEBSITE_URL": "https://rowie.eu",
        "EXPO_PUBLIC_VENDOR_DASHBOARD_URL": "https://portal.rowie.eu",
        "EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY": ""
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6761461763",
        "appleTeamId": "3TWW4NUYWM"
      }
    },
    "dev": {
      "ios": {
        "ascAppId": "6761461763",
        "appleTeamId": "3TWW4NUYWM"
      }
    }
  }
}
