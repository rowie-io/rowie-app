{
  "//": [
    "SECURITY: react-native-international-phone-number + react-native-country-select",
    "were VENDORED into src/vendor/ (2026-07-10) after the upstream maintainer",
    "shipped compromised versions to npm. Never reinstall those packages.",
    "libphonenumber-js stays as a real dep — trusted + actively maintained."
  ],
  "name": "rowie-app",
  "version": "1.0.4",
  "main": "index.ts",
  "scripts": {
    "dev": "cross-env EXPO_NO_DOTENV=1 dotenv -e .env -- expo start --port 4336",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "cross-env EXPO_NO_DOTENV=1 dotenv -e .env.local -- expo start --web --port 4336",
    "build:dev": "eas build --profile dev --platform ios",
    "build:dev:ios": "eas build --profile dev --platform ios --auto-submit",
    "build:prod": "eas build --profile prod --platform ios",
    "submit:ios": "eas submit --platform ios",
    "sim": "npx expo start"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~55.0.11",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/bottom-tabs": "^7.8.12",
    "@react-navigation/native": "^7.1.25",
    "@react-navigation/native-stack": "^7.8.6",
    "@stripe/stripe-react-native": "0.63.0",
    "@stripe/stripe-terminal-react-native": "^0.0.1-beta.31",
    "@tanstack/react-query": "^5.101.2",
    "expo": "^55.0.0",
    "expo-alternate-app-icons": "^8.0.0",
    "expo-blur": "~55.0.15",
    "expo-build-properties": "~55.0.15",
    "expo-camera": "~55.0.20",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.36",
    "expo-device": "~55.0.18",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.15",
    "expo-image-manipulator": "~55.0.18",
    "expo-image-picker": "~55.0.21",
    "expo-linear-gradient": "~55.0.15",
    "expo-local-authentication": "~55.0.15",
    "expo-secure-store": "~55.0.15",
    "expo-splash-screen": "~55.0.22",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.19",
    "libphonenumber-js": "^1.13.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-iap": "^14.7.20",
    "react-native-nitro-modules": "^0.35.10",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@stripe/stripe-terminal-react-native"
        ]
      }
    }
  }
}
